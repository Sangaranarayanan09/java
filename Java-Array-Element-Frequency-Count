import java.util.Scanner;
public class Main {
    public static void main(String[] args) { 
        Scanner sc= new Scanner(System.in);
            int arr[] = {10,20,10,40,20,20,10};
            int target=sc.nextInt();
            int count=0;
            for(int i:arr){
                if(i==target){
                    count++;
                }
            }
        
        System.out.println(count);
    }
}
